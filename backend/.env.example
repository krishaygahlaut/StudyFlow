NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/studyflow_pro

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_also_32_chars
JWT_REFRESH_EXPIRE=30d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (Nodemailer - use Gmail or Mailtrap for dev)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user
EMAIL_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@studyflow.app
EMAIL_FROM_NAME=StudyFlow

# Admin credentials (for initial seed)
ADMIN_EMAIL=admin@studyflow.app
ADMIN_PASSWORD=Admin@123456

# File upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
